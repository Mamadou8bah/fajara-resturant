# Staging — Netlify web → Render API
# Set in Netlify → Site configuration → Environment variables
# (or copy to client/.env.staging.local for local builds against staging API)

NEXT_PUBLIC_API_URL="https://YOUR-API.onrender.com/api"
NEXT_PUBLIC_WS_URL="https://YOUR-API.onrender.com/realtime"
NEXT_PUBLIC_APP_ENV="staging"
NEXT_PUBLIC_SENTRY_DSN=""
