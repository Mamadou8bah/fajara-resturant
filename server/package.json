{
  "name": "@fajara/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fajara Restaurant Services API (NestJS + Prisma)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:staging": "prisma migrate deploy && tsx prisma/seed.ts && node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:staging": "tsx ./scripts/prisma-migrate-deploy.ts",
    "push": "prisma db push",
    "push:staging": "tsx ./scripts/prisma-db-push.ts",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:dev": "tsx prisma/seed.ts",
    "seed:staging": "tsx --env-file=.env.staging prisma/seed.ts",
    "release:staging": "prisma migrate deploy && tsx prisma/seed.ts",
    "test:ac": "tsx test/acceptance/run.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.7",
    "@nestjs/platform-socket.io": "^11.0.7",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.0.7",
    "@prisma/client": "^6.3.1",
    "@sentry/node": "^10.74.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "multer": "^2.3.0",
    "prisma": "^6.3.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "uuid": "^11.0.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.0.0",
    "@types/web-push": "^3.6.4"
  }
}
