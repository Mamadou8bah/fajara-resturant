generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  WAITER
  KITCHEN
  CASHIER
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  NEEDS_CLEANING
}

enum SessionStatus {
  OPEN
  SETTLED
  CLOSED
}

enum OrderStatus {
  draft
  placed
  submitted
  preparing
  ready
  served
  partially_paid
  paid
  cancelled
  voided
  refunded
}

enum OrderItemStatus {
  draft
  placed
  submitted
  preparing
  ready
  served
  cancelled
  voided
  comped
}

enum OrderSource {
  GUEST
  WAITER
}

enum InventoryItemType {
  RAW
  PREPARED_COMPONENT
  PREPARED_FINISHED
  PACKAGED
}

enum InventoryMovementType {
  purchase_receipt
  production_input
  production_output
  sale_consumption
  waste
  staff_meal
  spoilage
  adjustment
  stock_return
  opening_stock
}

enum ModifierInventoryEffect {
  NONE
  ADD
  REMOVE
  REPLACE
}

enum SpecialType {
  WEEKLY
  CHEF
}

enum PromotionType {
  PERCENT_OFF_ALL
  PERCENT_OFF_CATEGORY
  PERCENT_OFF_ITEMS
  FIXED_PRICE_ITEMS
}

enum NotificationStatus {
  created
  delivered
  seen
  accepted
  resolved
  expired
}

enum TillMovementType {
  sale
  refund
  paid_in
  paid_out
  adjustment
}

enum PayrollStatus {
  DUE
  PAID
  CANCELLED
}

enum IdempotencyScope {
  ORDER
  PAYMENT
  SESSION
  KITCHEN
  MUTATION
}

model Employee {
  id           String    @id @default(uuid()) @db.Uuid
  employeeCode String?   @unique @map("employee_code")
  fullName     String    @map("full_name")
  email        String?   @unique
  phone        String?
  role         Role
  designation  String?
  pinHash      String?   @map("pin_hash")
  passwordHash String?   @map("password_hash")
  photoUrl     String?   @map("photo_url")
  isActive     Boolean   @default(true) @map("is_active")
  startDate    DateTime? @map("start_date") @db.Date
  payStructure String?   @map("pay_structure")
  baseAmount   Decimal?  @map("base_amount") @db.Decimal(12, 2)
  paySchedule  String?   @map("pay_schedule")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  archivedAt   DateTime? @map("archived_at")

  sessions            EmployeeSession[]
  openedTableSessions TableSession[]         @relation("SessionWaiter")
  ordersAsWaiter      Order[]                @relation("OrderWaiter")
  activityLogs        ActivityLog[]
  notifications       Notification[]
  shifts              EmployeeShift[]
  payrollRecords      PayrollRecord[]
  tillSessions        TillSession[]
  stockReceipts       StockReceipt[]
  productionBatches   ProductionBatch[]
  inventoryMovements  InventoryMovement[]
  approvedExceptions  OrderException[]       @relation("ExceptionApprover")
  createdExceptions   OrderException[]       @relation("ExceptionActor")
  transactions        Transaction[]          @relation("TransactionCashier")
  refunds             Refund[]
  idempotencyKeys     IdempotencyKey[]
  paymentCorrectionsActor    PaymentCorrection[] @relation("PaymentCorrectionActor")
  paymentCorrectionsApprover PaymentCorrection[] @relation("PaymentCorrectionApprover")
  pushSubscriptions   PushSubscription[]

  @@map("employees")
}

model EmployeeSession {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  tokenHash        String    @map("token_hash")
  deviceLabel      String?   @map("device_label")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lockUntil        DateTime? @map("lock_until")
  failedPinCount   Int       @default(0) @map("failed_pin_count")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([tokenHash])
  @@map("employee_sessions")
}

model DiningTable {
  id           String      @id @default(uuid()) @db.Uuid
  number       String      @unique
  label        String?
  seats        Int         @default(4)
  status       TableStatus @default(FREE)
  sortOrder    Int         @default(0) @map("sort_order")
  /** Floor plan position as % of canvas (0–100). Null = auto layout. */
  posX         Float?      @map("pos_x")
  posY         Float?      @map("pos_y")
  isArchived   Boolean     @default(false) @map("is_archived")
  reservationName      String?   @map("reservation_name")
  reservationPartySize Int?      @map("reservation_party_size")
  reservationAt        DateTime? @map("reservation_at")
  reservationNote      String?   @map("reservation_note")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  qrTokens TableQrToken[]
  sessions TableSession[]

  @@map("tables")
}

model TableQrToken {
  id          String    @id @default(uuid()) @db.Uuid
  tableId     String    @map("table_id") @db.Uuid
  token       String    @unique
  isActive    Boolean   @default(true) @map("is_active")
  rotatedAt   DateTime? @map("rotated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  deactivatedAt DateTime? @map("deactivated_at")

  table DiningTable @relation(fields: [tableId], references: [id])

  @@index([tableId])
  @@map("table_qr_tokens")
}

model TableSession {
  id             String        @id @default(uuid()) @db.Uuid
  tableId        String        @map("table_id") @db.Uuid
  waiterId       String?       @map("waiter_id") @db.Uuid
  status         SessionStatus @default(OPEN)
  guestCount     Int           @default(0) @map("guest_count")
  openedAt       DateTime      @default(now()) @map("opened_at")
  closedAt       DateTime?     @map("closed_at")
  reservationName String?      @map("reservation_name")
  reservationNote String?      @map("reservation_note")
  reservationAt   DateTime?    @map("reservation_at")
  reservationPartySize Int?    @map("reservation_party_size")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  table   DiningTable @relation(fields: [tableId], references: [id])
  waiter  Employee?   @relation("SessionWaiter", fields: [waiterId], references: [id])
  guests  Guest[]
  orders  Order[]
  moves   TableSessionMove[]
  transactions Transaction[]
  notifications Notification[]

  @@index([tableId, status])
  @@index([waiterId])
  @@index([openedAt])
  @@map("table_sessions")
}

model TableSessionMove {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  fromTableId    String   @map("from_table_id") @db.Uuid
  toTableId      String   @map("to_table_id") @db.Uuid
  movedById      String?  @map("moved_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  session TableSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("table_session_moves")
}

model Guest {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  displayName String?  @map("display_name")
  deviceToken String?  @unique @map("device_token")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  session    TableSession @relation(fields: [sessionId], references: [id])
  orderItems OrderItem[]
  pushSubscriptions PushSubscription[]

  @@index([sessionId])
  @@map("guests")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  isActive   Boolean   @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id              String    @id @default(uuid()) @db.Uuid
  categoryId      String?   @map("category_id") @db.Uuid
  name            String
  description     String?
  price           Decimal   @db.Decimal(12, 2)
  photoUrl        String?   @map("photo_url")
  allergens       String[]  @default([])
  isAvailable     Boolean   @default(true) @map("is_available")
  isSoldOut       Boolean   @default(false) @map("is_sold_out")
  station         String    @default("Main Kitchen")
  /** When false, item skips KDS and goes waiter → cashier after release. */
  requiresKitchen Boolean   @default(true) @map("requires_kitchen")
  /** Estimated prep time shown on KDS (minutes). */
  prepMinutes     Int?      @map("prep_minutes")
  sortOrder       Int       @default(0) @map("sort_order")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  category       Category?       @relation(fields: [categoryId], references: [id])
  modifierGroups ModifierGroup[]
  recipes        Recipe[]
  specials       Special[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@map("menu_items")
}

model ModifierGroup {
  id           String   @id @default(uuid()) @db.Uuid
  menuItemId   String?  @map("menu_item_id") @db.Uuid
  name         String
  minSelect    Int      @default(0) @map("min_select")
  maxSelect    Int      @default(1) @map("max_select")
  isRequired   Boolean  @default(false) @map("is_required")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime @default(now()) @map("created_at")

  menuItem MenuItem?        @relation(fields: [menuItemId], references: [id])
  options  ModifierOption[]

  @@index([menuItemId])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String                  @id @default(uuid()) @db.Uuid
  groupId         String                  @map("group_id") @db.Uuid
  name            String
  priceEffect     Decimal                 @default(0) @map("price_effect") @db.Decimal(12, 2)
  inventoryEffect ModifierInventoryEffect @default(NONE) @map("inventory_effect")
  inventoryItemId String?                 @map("inventory_item_id") @db.Uuid
  quantityEffect  Decimal?                @map("quantity_effect") @db.Decimal(12, 3)
  isActive        Boolean                 @default(true) @map("is_active")
  sortOrder       Int                     @default(0) @map("sort_order")
  archivedAt      DateTime?               @map("archived_at")

  group         ModifierGroup  @relation(fields: [groupId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  orderMods     OrderItemModifier[]

  @@index([groupId])
  @@map("modifier_options")
}

model Special {
  id              String      @id @default(uuid()) @db.Uuid
  menuItemId      String      @map("menu_item_id") @db.Uuid
  type            SpecialType
  name            String?
  specialPrice    Decimal?    @map("special_price") @db.Decimal(12, 2)
  quantityLimit   Int?        @map("quantity_limit")
  quantityRemaining Int?      @map("quantity_remaining")
  startsAt        DateTime?   @map("starts_at")
  endsAt          DateTime?   @map("ends_at")
  weekday         Int?
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([menuItemId, isActive])
  @@map("specials")
}

model Promotion {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  type        PromotionType
  percentOff  Decimal?      @map("percent_off") @db.Decimal(5, 2)
  fixedPrice  Decimal?      @map("fixed_price") @db.Decimal(12, 2)
  categoryIds String[]      @default([]) @map("category_ids") @db.Uuid
  menuItemIds String[]      @default([]) @map("menu_item_ids") @db.Uuid
  startsAt    DateTime?     @map("starts_at")
  endsAt      DateTime?     @map("ends_at")
  isActive    Boolean       @default(true) @map("is_active")
  priority    Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([isActive, priority])
  @@map("promotions")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  orderNumber    String      @unique @map("order_number")
  sessionId      String      @map("session_id") @db.Uuid
  waiterId       String?     @map("waiter_id") @db.Uuid
  source         OrderSource
  status         OrderStatus @default(submitted)
  clientRequestId String?    @map("client_request_id")
  notes          String?
  submittedAt    DateTime    @default(now()) @map("submitted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  session  TableSession @relation(fields: [sessionId], references: [id])
  waiter   Employee?    @relation("OrderWaiter", fields: [waiterId], references: [id])
  items    OrderItem[]
  exceptions OrderException[]

  @@unique([clientRequestId])
  @@index([sessionId, status])
  @@index([submittedAt])
  @@map("orders")
}

model OrderItem {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @map("order_id") @db.Uuid
  guestId               String          @map("guest_id") @db.Uuid
  menuItemId            String?         @map("menu_item_id") @db.Uuid
  nameSnapshot          String          @map("name_snapshot")
  priceSnapshot         Decimal         @map("price_snapshot") @db.Decimal(12, 2)
  quantity              Int             @default(1)
  status                OrderItemStatus @default(submitted)
  kitchenNotes          String?         @map("kitchen_notes")
  isTakeaway            Boolean         @default(false) @map("is_takeaway")
  preparedAt            DateTime?       @map("prepared_at")
  readyAt               DateTime?       @map("ready_at")
  servedAt              DateTime?       @map("served_at")
  settledTransactionId  String?         @map("settled_transaction_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  order               Order               @relation(fields: [orderId], references: [id])
  guest               Guest               @relation(fields: [guestId], references: [id])
  menuItem            MenuItem?           @relation(fields: [menuItemId], references: [id])
  settledTransaction  Transaction?        @relation(fields: [settledTransactionId], references: [id])
  modifiers           OrderItemModifier[]
  exceptions          OrderException[]

  @@index([orderId])
  @@index([guestId])
  @@index([status])
  @@index([settledTransactionId])
  @@map("order_items")
}

model OrderItemModifier {
  id                String  @id @default(uuid()) @db.Uuid
  orderItemId       String  @map("order_item_id") @db.Uuid
  modifierOptionId  String? @map("modifier_option_id") @db.Uuid
  nameSnapshot      String  @map("name_snapshot")
  priceSnapshot     Decimal @map("price_snapshot") @db.Decimal(12, 2)
  groupNameSnapshot String? @map("group_name_snapshot")

  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id])
  modifierOption ModifierOption? @relation(fields: [modifierOptionId], references: [id])

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderException {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String?  @map("order_id") @db.Uuid
  orderItemId     String?  @map("order_item_id") @db.Uuid
  type            String
  reason          String
  actorId         String   @map("actor_id") @db.Uuid
  approvedById    String?  @map("approved_by_id") @db.Uuid
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  order      Order?     @relation(fields: [orderId], references: [id])
  orderItem  OrderItem? @relation(fields: [orderItemId], references: [id])
  actor      Employee   @relation("ExceptionActor", fields: [actorId], references: [id])
  approvedBy Employee?  @relation("ExceptionApprover", fields: [approvedById], references: [id])

  @@index([orderId])
  @@index([createdAt])
  @@map("order_exceptions")
}

model Transaction {
  id                String   @id @default(uuid()) @db.Uuid
  transactionNumber String   @unique @map("transaction_number")
  sessionId         String   @map("session_id") @db.Uuid
  cashierId         String?  @map("cashier_id") @db.Uuid
  guestId           String?  @map("guest_id") @db.Uuid
  subtotal          Decimal  @db.Decimal(12, 2)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  taxLabel          String?  @map("tax_label")
  taxRateSnapshot   Decimal? @map("tax_rate_snapshot") @db.Decimal(6, 3)
  tipAmount         Decimal  @default(0) @map("tip_amount") @db.Decimal(12, 2)
  total             Decimal  @db.Decimal(12, 2)
  status            String   @default("completed")
  clientRequestId   String?  @unique @map("client_request_id")
  createdAt         DateTime @default(now()) @map("created_at")

  session      TableSession         @relation(fields: [sessionId], references: [id])
  cashier      Employee?            @relation("TransactionCashier", fields: [cashierId], references: [id])
  payments     TransactionPayment[]
  refunds      Refund[]
  settledItems OrderItem[]

  @@index([sessionId])
  @@index([createdAt])
  @@map("transactions")
}

model TransactionPayment {
  id              String   @id @default(uuid()) @db.Uuid
  transactionId   String   @map("transaction_id") @db.Uuid
  method          String
  amount          Decimal  @db.Decimal(12, 2)
  reference       String?
  cashReceived    Decimal? @map("cash_received") @db.Decimal(12, 2)
  cashChange      Decimal? @map("cash_change") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  corrections PaymentCorrection[]

  @@index([transactionId])
  @@map("transaction_payments")
}

model PaymentCorrection {
  id                   String   @id @default(uuid()) @db.Uuid
  transactionPaymentId String   @map("transaction_payment_id") @db.Uuid
  previousMethod       String   @map("previous_method")
  newMethod            String   @map("new_method")
  reason               String
  actorId              String   @map("actor_id") @db.Uuid
  approvedById         String   @map("approved_by_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")

  payment    TransactionPayment @relation(fields: [transactionPaymentId], references: [id])
  actor      Employee           @relation("PaymentCorrectionActor", fields: [actorId], references: [id])
  approvedBy Employee           @relation("PaymentCorrectionApprover", fields: [approvedById], references: [id])

  @@index([transactionPaymentId])
  @@map("payment_corrections")
}

model SequenceCounter {
  name  String @id
  value Int    @default(0)

  @@map("sequence_counters")
}

model Refund {
  id                String   @id @default(uuid()) @db.Uuid
  transactionId     String   @map("transaction_id") @db.Uuid
  amount            Decimal  @db.Decimal(12, 2)
  reason            String
  actorId           String   @map("actor_id") @db.Uuid
  method            String?
  createdAt         DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  actor       Employee    @relation(fields: [actorId], references: [id])

  @@index([transactionId])
  @@map("refunds")
}

model TillSession {
  id             String    @id @default(uuid()) @db.Uuid
  cashierId      String    @map("cashier_id") @db.Uuid
  openedById     String?   @map("opened_by_id") @db.Uuid
  deviceLabel    String?   @map("device_label")
  openingBalance Decimal   @map("opening_balance") @db.Decimal(12, 2)
  expectedCash   Decimal?  @map("expected_cash") @db.Decimal(12, 2)
  actualCash     Decimal?  @map("actual_cash") @db.Decimal(12, 2)
  variance       Decimal?  @db.Decimal(12, 2)
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  notes          String?

  cashier   Employee       @relation(fields: [cashierId], references: [id])
  movements TillMovement[]

  @@index([cashierId, closedAt])
  @@map("till_sessions")
}

model TillMovement {
  id            String           @id @default(uuid()) @db.Uuid
  tillSessionId String           @map("till_session_id") @db.Uuid
  type          TillMovementType
  amount        Decimal          @db.Decimal(12, 2)
  reason        String?
  actorId       String?          @map("actor_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")

  tillSession TillSession @relation(fields: [tillSessionId], references: [id])

  @@index([tillSessionId])
  @@map("till_movements")
}

model InventoryItem {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  type             InventoryItemType
  baseUnit         String            @map("base_unit")
  purchaseUnit     String?           @map("purchase_unit")
  conversionFactor Decimal?          @map("conversion_factor") @db.Decimal(12, 4)
  currentStock     Decimal           @default(0) @map("current_stock") @db.Decimal(14, 3)
  lowStockThreshold Decimal?         @map("low_stock_threshold") @db.Decimal(14, 3)
  isActive         Boolean           @default(true) @map("is_active")
  archivedAt       DateTime?         @map("archived_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  recipeItems        RecipeItem[]
  movements          InventoryMovement[]
  stockReceipts      StockReceipt[]
  modifierOptions    ModifierOption[]
  productionOutputs  ProductionBatch[] @relation("BatchOutputItem")

  @@map("inventory_items")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  contact   String?
  phone     String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  receipts StockReceipt[]

  @@map("suppliers")
}

model StockReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  supplierId      String?  @map("supplier_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  quantity        Decimal  @db.Decimal(14, 3)
  unit            String
  unitCost        Decimal? @map("unit_cost") @db.Decimal(12, 2)
  receivedById    String?  @map("received_by_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at")
  notes           String?

  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  receivedBy    Employee?     @relation(fields: [receivedById], references: [id])

  @@index([inventoryItemId])
  @@map("stock_receipts")
}

model Recipe {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  menuItemId  String?  @map("menu_item_id") @db.Uuid
  kind        String   @default("dish")
  yieldQty    Decimal? @map("yield_qty") @db.Decimal(14, 3)
  yieldUnit   String?  @map("yield_unit")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  menuItem MenuItem?   @relation(fields: [menuItemId], references: [id])
  items    RecipeItem[]
  batches  ProductionBatch[]

  @@index([menuItemId])
  @@map("recipes")
}

model RecipeItem {
  id              String  @id @default(uuid()) @db.Uuid
  recipeId        String  @map("recipe_id") @db.Uuid
  inventoryItemId String  @map("inventory_item_id") @db.Uuid
  quantity        Decimal @db.Decimal(14, 3)
  unit            String

  recipe        Recipe        @relation(fields: [recipeId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([recipeId])
  @@map("recipe_items")
}

model ProductionBatch {
  id                String   @id @default(uuid()) @db.Uuid
  recipeId          String   @map("recipe_id") @db.Uuid
  outputItemId      String   @map("output_item_id") @db.Uuid
  batchSizeLabel    String   @map("batch_size_label")
  expectedYield     Decimal  @map("expected_yield") @db.Decimal(14, 3)
  actualYield       Decimal  @map("actual_yield") @db.Decimal(14, 3)
  actorId           String?  @map("actor_id") @db.Uuid
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  recipe     Recipe        @relation(fields: [recipeId], references: [id])
  outputItem InventoryItem @relation("BatchOutputItem", fields: [outputItemId], references: [id])
  actor      Employee?     @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@map("production_batches")
}

model InventoryMovement {
  id              String                @id @default(uuid()) @db.Uuid
  inventoryItemId String                @map("inventory_item_id") @db.Uuid
  type            InventoryMovementType
  quantity        Decimal               @db.Decimal(14, 3)
  unit            String
  reason          String?
  actorId         String?               @map("actor_id") @db.Uuid
  referenceType   String?               @map("reference_type")
  referenceId     String?               @map("reference_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  actor         Employee?     @relation(fields: [actorId], references: [id])

  @@index([inventoryItemId, createdAt])
  @@index([type])
  @@map("inventory_movements")
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  type        String
  title       String
  body        String?
  status      NotificationStatus @default(created)
  employeeId  String?            @map("employee_id") @db.Uuid
  sessionId   String?            @map("session_id") @db.Uuid
  payload     Json?
  createdAt   DateTime           @default(now()) @map("created_at")
  seenAt      DateTime?          @map("seen_at")
  resolvedAt  DateTime?          @map("resolved_at")
  expiresAt   DateTime?          @map("expires_at")

  employee Employee?     @relation(fields: [employeeId], references: [id])
  session  TableSession? @relation(fields: [sessionId], references: [id])

  @@index([employeeId, status])
  @@index([createdAt])
  @@map("notifications")
}

/** Web Push endpoints for closed-browser / iOS Home Screen alerts. */
model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  employeeId String?  @map("employee_id") @db.Uuid
  guestId    String?  @map("guest_id") @db.Uuid
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  guest    Guest?    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([guestId])
  @@map("push_subscriptions")
}

model ShiftType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  color     String?
  isActive  Boolean  @default(true) @map("is_active")

  shifts EmployeeShift[]

  @@map("shift_types")
}

model EmployeeShift {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  shiftTypeId  String?  @map("shift_type_id") @db.Uuid
  workDate     DateTime @map("work_date") @db.Date
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  employee  Employee   @relation(fields: [employeeId], references: [id])
  shiftType ShiftType? @relation(fields: [shiftTypeId], references: [id])

  @@index([employeeId, workDate])
  @@index([workDate])
  @@map("employee_shifts")
}

model ShiftTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("shift_templates")
}

model PayrollRecord {
  id           String        @id @default(uuid()) @db.Uuid
  employeeId   String        @map("employee_id") @db.Uuid
  periodStart  DateTime      @map("period_start") @db.Date
  periodEnd    DateTime      @map("period_end") @db.Date
  amountDue    Decimal       @map("amount_due") @db.Decimal(12, 2)
  status       PayrollStatus @default(DUE)
  paidAt       DateTime?     @map("paid_at")
  method       String?
  approvedById String?       @map("approved_by_id") @db.Uuid
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, periodStart])
  @@map("payroll_records")
}

model ActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actionType   String   @map("action_type")
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  description  String
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor Employee? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("settings")
}

model IdempotencyKey {
  id           String           @id @default(uuid()) @db.Uuid
  scope        IdempotencyScope
  key          String
  employeeId   String?          @map("employee_id") @db.Uuid
  responseJson Json?            @map("response_json")
  createdAt    DateTime         @default(now()) @map("created_at")

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@unique([scope, key])
  @@map("idempotency_keys")
}
