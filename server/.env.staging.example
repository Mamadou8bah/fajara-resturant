# Staging — local docker UAT (default). See .env.staging.hosted.example for HTTPS hosts.
#
# 1) docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d
# 2) cp .env.staging.example .env.staging
# 3) pnpm migrate:staging && pnpm seed:staging

APP_ENV=staging
NODE_ENV=production

DATABASE_URL="postgresql://fajara_stg:fajara_stg@localhost:5433/fajara_staging?schema=public"

API_PORT=4000
JWT_SECRET="REPLACE_WITH_UNIQUE_STAGING_SECRET_MIN_32_CHARS"

CORS_ORIGIN="http://localhost:3000"
PUBLIC_WEB_URL="http://localhost:3000"

# Web Push (VAPID) — generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@fajara.local"

SEED_PIN="1234"
SEED_OWNER_PASSWORD="ChangeMe123!"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

SENTRY_DSN=""
