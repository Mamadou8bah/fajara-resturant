# Staging — Render API + Netlify web + Neon Postgres (hosted HTTPS)
# Set these in the Render dashboard (Environment), not by committing secrets.
# Deploy runs migrate + seed via render.yaml preDeployCommand.

APP_ENV=staging
NODE_ENV=production

# Neon pooled connection string (Console → Connection details → Pooled)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct (non-pooler) URL for migrations — copy "Direct" from Neon console.
# If unset, deploy scripts strip "-pooler" from DATABASE_URL automatically.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Render sets PORT automatically; API_PORT is a local fallback only
API_PORT=4000
JWT_SECRET="REPLACE_WITH_UNIQUE_STAGING_SECRET_MIN_32_CHARS"

# Netlify site origin(s) — must match the browser URL exactly
CORS_ORIGIN="https://YOUR-SITE.netlify.app"
PUBLIC_WEB_URL="https://YOUR-SITE.netlify.app"

# Web Push (VAPID) — generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@fajara.local"

SEED_PIN="1234"
SEED_OWNER_PASSWORD="ChangeMe123!"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

SENTRY_DSN=""
